# Datasets (no versionar archivos de datos pesados, solo .gitkeep)
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Model weights & large media files
*.pt
*.pth
*.onnx
*.safetensors
*.bin

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db

# LaTeX build artifacts
**/docs/*.aux
**/docs/*.log
**/docs/*.out
**/docs/*.toc
**/docs/*.synctex.gz
**/docs/page-*.png

# Notas internas locales (no se versionan ni se pushean)
**/docs/FEEDBACK_*.md
