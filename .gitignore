# Datasets (no versionar archivos de datos pesados, solo .gitkeep)
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Model weights & large media files
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db

# LaTeX build artifacts
**/docs/*.aux
**/docs/*.log
**/docs/*.out
**/docs/*.toc
**/docs/*.synctex.gz
**/docs/page-*.png

# Notas internas locales (no se versionan ni se pushean)
**/docs/FEEDBACK_*.md

# Local secrets
.env

# Entregables y material con fotos de personas: se entregan por Drive, no se publican
Project-II/entregable/*.pdf
Project-II/entregable/*.pptx
Project-II/material_apoyo/informe/figuras/
Project-II/material_apoyo/informe/informe.html
Project-II/material_apoyo/presentacion/fuentes_ppt/img/
